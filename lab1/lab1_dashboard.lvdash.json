                    "themeColorType": "visualizationColors",
                    "position": 9
                  },
                  {
                    "themeColorType": "visualizationColors",
                    "position": 10
                  }
                ]
              },
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "avg(anxiety_score_0to27)",
                  "displayName": "Average Anxiety Score",
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "y": {
                  "fieldName": "gender",
                  "displayName": "Gender",
                  "scale": {
                    "type": "categorical"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "users",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "dataset1",
                  "fields": [
                    {
                      "name": "count(*)",
                      "expression": "COUNT(`*`)"
                    },
                    {
                      "name": "most_used_platform",
                      "expression": "`most_used_platform`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "frame": {
                "showTitle": true,
                "title": "Social Media Platform Usage"
              },
              "widgetType": "pie",
              "encodings": {
                "angle": {
                  "fieldName": "count(*)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Count of users"
                },
                "color": {
                  "fieldName": "most_used_platform",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "label": {
                  "show": true
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 0,
            "width": 6,
            "height": 8
          }
        },
        {
          "widget": {
            "name": "avg-self-esteem-score-platform",
