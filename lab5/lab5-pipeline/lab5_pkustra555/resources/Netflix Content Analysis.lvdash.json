{
  "datasets": [
    {
      "name": "2661cc02",
      "displayName": "Summary",
      "queryLines": [
        "SELECT\r\n",
        "    f.event_id,s.show_id,s.title, s.type, s.rating, s.audience_category,s.release_year, s.release_period, d.view_date, d.year,d.month, \r\n",
        "    u.user_id, f.view_count, f.rate\r\n",
        "FROM dbr_dev.pkustra555_gold.fact_views f\r\n",
        "LEFT JOIN dbr_dev.pkustra555_gold.dim_show s\r\n",
        "    ON f.show_key = s.show_key\r\n",
        "LEFT JOIN dbr_dev.pkustra555_gold.dim_date d\r\n",
        "    ON f.date_key = d.date_key\r\n",
        "LEFT JOIN dbr_dev.pkustra555_gold.dim_user u\r\n",
        "    ON f.user_key = u.user_key\r\n",
        "WHERE s.audience_category IS NOT NULL"
      ]
    },
    {
      "name": "e13a06e1",
      "displayName": "count_kpi",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    COUNT(*) AS total_titles,\r\n    SUM(CASE WHEN type = 'Movie' THEN 1 ELSE 0 END) AS total_movies,\r\n    SUM(CASE WHEN type = 'TV Show' THEN 1 ELSE 0 END) AS total_tv_shows\r\nFROM dbr_dev.pkustra555_gold.dim_show",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "2edb0dec",
      "displayName": "movies_tv_shows",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    type,\r\n    COUNT(*) AS total_titles\r\nFROM dbr_dev.pkustra555_gold.dim_show\r\nGROUP BY type\r\n",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "697f2bb6",
      "displayName": "audience_category",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    audience_category,\r\n    COUNT(*) AS total_titles\r\nFROM dbr_dev.pkustra555_gold.dim_show\r\nWHERE audience_category IS NOT NULL\r\nGROUP BY audience_category\r\n",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "cab33d4d",
      "displayName": "release_period",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    release_period,\r\n    COUNT(*) AS total_titles\r\nFROM dbr_dev.pkustra555_gold.dim_show\r\nWHERE release_period IS NOT NULL\r\nGROUP BY release_period",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "10066068",
      "displayName": "total_views",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    SUM(view_count) AS total_views,\r\n    COUNT(DISTINCT user_key) AS unique_viewers,\r\n    ROUND(AVG(rate), 2) AS avg_rating\r\nFROM dbr_dev.pkustra555_gold.fact_views",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "a80e0bb0",
      "displayName": "top10_watched",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    title,\r\n    total_views,\r\n    avg_rate,\r\n    unique_viewers\r\nFROM dbr_dev.pkustra555_gold.gold_views_by_show\r\nORDER BY total_views DESC\r\nLIMIT 10",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "7ea2bc54",
      "displayName": "views_over_time",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    view_date,\r\n    total_views,\r\n    unique_viewers,\r\n    avg_rate\r\nFROM dbr_dev.pkustra555_gold.gold_views_by_date\r\nORDER BY view_date",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "575679db",
      "displayName": "top10_rated",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    title,\r\n    total_views,\r\n    avg_rate\r\nFROM dbr_dev.pkustra555_gold.gold_views_by_show\r\nWHERE total_views >= 5\r\nORDER BY avg_rate DESC, total_views DESC\r\nLIMIT 10",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    }
  ],
