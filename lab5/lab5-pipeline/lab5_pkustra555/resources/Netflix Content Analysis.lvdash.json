    },
    {
      "name": "bb76fc04",
      "displayName": "audience_category",
      "queryLines": [
        "SELECT *\r\n",
        "FROM dbr_dev.pkustra555_gold.gold_titles_by_audience\r\n",
        "WHERE audience_category IS NOT NULL"
      ]
    },
    {
      "name": "2661cc02",
      "displayName": "Summary",
      "queryLines": [
        "SELECT f.show_id, f.title_count, t.type, r.rating, r.audience_category, y.release_year, y.release_period  \r\n",
        "FROM dbr_dev.pkustra555_gold.fact_tiles f\r\n",
        "LEFT JOIN dbr_dev.pkustra555_gold.dim_type t\r\n",
        "    ON f.type_key = t.type_key\r\n",
        "LEFT JOIN dbr_dev.pkustra555_gold.dim_rating r\r\n",
        "    ON f.rating_key = r.rating_key\r\n",
        "LEFT JOIN dbr_dev.pkustra555_gold.dim_release_year y\r\n",
        "    ON f.release_year_key = y.release_year_key\r\n",
        "WHERE r.audience_category IS NOT NULL"
      ]
    }
  ],
